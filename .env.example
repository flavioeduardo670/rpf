# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-forte
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=seu-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://seu-app.onrender.com
RENDER_EXTERNAL_HOSTNAME=seu-app.onrender.com
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_PRELOAD=False
DATABASE_URL=sqlite:///db.sqlite3

# --- Produto ---
# Nome do ERP (provisório). O nome de cada cliente fica no Admin, em "Organizações".
PRODUTO_NOME=ERP

# --- Mercado Pago (PIX) ---
# Sem MERCADOPAGO_WEBHOOK_SECRET o webhook de pagamento é RECUSADO em produção.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://seu-app.onrender.com/financeiro/pix/webhook/

# --- E-mail (comprovantes de aluguel) ---
# No Render gratuito o SMTP é bloqueado: use BREVO_API_KEY (API HTTPS do Brevo).
BREVO_API_KEY=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=

# --- Notas fiscais no Compras ---
# 1) Leitura pela foto da nota (API do Claude)
ANTHROPIC_API_KEY=
NFCE_FOTO_MODELO=claude-opus-5-5
# 3) Caixa de e-mail que recebe o XML das notas (cron: python manage.py importar_notas_email)
NFE_EMAIL_IMAP_HOST=imap.gmail.com
NFE_EMAIL_IMAP_PORTA=993
NFE_EMAIL_USUARIO=
NFE_EMAIL_SENHA=
NFE_EMAIL_PASTA=INBOX
# 4) NF-e no CNPJ da república pela Receita (cron de hora em hora: python manage.py importar_nfe_receita)
NFE_CNPJ=
NFE_CERTIFICADO_PFX_BASE64=
NFE_CERTIFICADO_SENHA=
NFE_UF=MG
NFE_AMBIENTE=1

# --- Monitoramento (opcional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
