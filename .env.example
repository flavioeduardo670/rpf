# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-forte
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=seu-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://seu-app.onrender.com
RENDER_EXTERNAL_HOSTNAME=seu-app.onrender.com
SECURE_HSTS_SECONDS=86400
SECURE_HSTS_PRELOAD=False
DATABASE_URL=sqlite:///db.sqlite3

# --- Mercado Pago (PIX) ---
# Sem MERCADOPAGO_WEBHOOK_SECRET o webhook de pagamento é RECUSADO em produção.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://seu-app.onrender.com/financeiro/pix/webhook/

# --- E-mail (comprovantes de aluguel) ---
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=

# --- Monitoramento (opcional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
